  "m_TableData": [
    {
      "m_Id": 49826996224,
      "m_Localized": "ไม่มีคืนของ ไม่มีใบเสร็จ และไม่มีใครเห็นชั้นทำ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 202143145984,
      "m_Localized": "มีเงินไหม? ชั้นมีของ...ที่ไม่ได้ขโมยมา",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 235265564672,
      "m_Localized": "บอกเลยว่านี่คุ้มกว่า Moai แน่นอน",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 260825653248,
      "m_Localized": "ซื้อเยอะๆ ซะ จะได้ช่วยลดภาระชั้นหน่อย",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 282938023936,
      "m_Localized": "เชื่อเถอะ ชั้นไม่ใช่คนที่น่าเชื่อถือ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 314324000768,
      "m_Localized": "เฮ้ อย่าไปบอก Moai ล่ะ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 341373067264,
      "m_Localized": "ได้กลิ่นนั้นไหม? กลิ่นดีลสุดยอดเลยล่ะ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 348960563200,
      "m_Localized": "ชั้นไม่ต้องการนิ้วเยอะขนาดนี้ เอาไปซักนิ้วสิ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 370913550336,
      "m_Localized": "ของแต่ละชิ้นร้อนผิดปกติ เหมือนเพิ่งถูกหยิบออกมาจากในเสื้อ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 432494321664,
      "m_Localized": "คุณกระพริบตา พอลืมตาอีกทีเขาก็มายืนใกล้ๆ ซะงั้น",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 456225693696,
      "m_Localized": "เขามีกลิ่นเหมือนน้ำตาลไหม้และโอโซนเล็กน้อย",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 487045439488,
      "m_Localized": "ชายลึกลับดึงสำรับไพ่ออกมาสับแล้วกินไปใบหนึ่ง เขาไม่อธิบายอะไรเลย",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 556817686528,
      "m_Localized": "รู้สึกว่าถามเรื่องภาษีกับเขาคงทำให้เขาหายตัวไปเลย",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 582478438400,
      "m_Localized": "เขาโน้มตัวเข้ามากระซิบว่า \"ตาคุณสวยจัง\"",
      "m_Metadata": {
        "m_Items": []
      }
    }
