  "m_Metadata": {
    "m_Items": []
  },
  "m_TableData": [
    {
      "m_Id": 49826996224,
      "m_Localized": "Sin devoluciones, sin recibos, sin testigos.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 202143145984,
      "m_Localized": "¿Tienes dinero? Yo tengo... cosas no-robadas.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 235265564672,
      "m_Localized": "Entre tú y yo... las ofertas del Moai no son nada comparadas a las mías.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 260825653248,
      "m_Localized": "Cuanto más compras, menos tengo que cargar. Ayuda a un compa.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 282938023936,
      "m_Localized": "Créeme. Soy muy poco fiable.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 314324000768,
      "m_Localized": "Oye, no le digas al Moai sobre esto, ¿vale?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 341373067264,
      "m_Localized": "¿Hueles eso? Es el aroma de una oferta increíble.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 348960563200,
      "m_Localized": "No necesito tantos dedos. Llévate uno.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 370913550336,
      "m_Localized": "Cada objeto está sospechosamente calentito, como si lo acabara de sacar de su abrigo.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 432494321664,
      "m_Localized": "Parpadeas. Cuando abres los ojos, de alguna manera está más cerca.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 456225693696,
      "m_Localized": "Huele a azúcar quemada y un poco a ozono.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 487045439488,
      "m_Localized": "El Tipo Sombra saca una baraja de cartas, las mezcla, y luego se come una. Se niega a explicar.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 556817686528,
      "m_Localized": "Sientes que si le preguntas sobre impuestos, él se evaporaría inmediatamente.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 582478438400,
      "m_Localized": "Se acerca y susurra: \"Tienes unos ojos preciosos.\"",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
  "references": {
    "version": 2,
