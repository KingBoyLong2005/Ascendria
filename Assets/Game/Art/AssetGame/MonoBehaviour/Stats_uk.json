  "m_TableData": [
    {
      "m_Id": 11411298951168,
      "m_Localized": "Максімальне ХП",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 12024481030144,
      "m_Localized": "Відновлення ХП",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 12321492279296,
      "m_Localized": "Відновлення ХП підвищує кількість життя, яке ти відновлюєш за хвилину.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 12454221029376,
      "m_Localized": "Щит",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 12566083117056,
      "m_Localized": "Щит приймає удари замість ХП, поки не зламається. Щит швидко відновлюється, якщо в тебе не влучали якийсь час.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 12884846026752,
      "m_Localized": "Шипи",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 12982942408704,
      "m_Localized": "Завдавай шкоди ворогам, коли вони атакують тебе.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 13124810547200,
      "m_Localized": "Броня",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 13160562794496,
      "m_Localized": "Броня зменшує шкоду, яку ти отримуєш.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 13348484390912,
      "m_Localized": "Ухилення",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 13361235075072,
      "m_Localized": "Ухилення — це шанс уникнути атаки без отримання шкоди.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 13626319282176,
      "m_Localized": "Розмір",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 13628353519616,
      "m_Localized": "Розмір твоїх атак, снарядів, вибухів і не тільки.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 13932146958336,
      "m_Localized": "Тривалість",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 13933384278016,
      "m_Localized": "Тривалість твоїх атак і снарядів.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 14128209698816,
      "m_Localized": "Швидкість Снарядів",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 14169276129280,
      "m_Localized": "Швидкість твоїх снарядів.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 14279779262464,
      "m_Localized": "Шкода",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 14282090323968,
      "m_Localized": "Підвищує шкоду від твоїх атак",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 14666708000768,
      "m_Localized": "Тривалість Ефектів",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 14668243116032,
      "m_Localized": "Тривалість ефектів, таких як отрута або лід.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 14800854425600,
      "m_Localized": "Швидкість Атаки",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 15228329500672,
      "m_Localized": "Як швидко ти стріляєш снарядами та виконуєш атаки.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 15429710618624,
      "m_Localized": "Кількість Снарядів",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 15430247489536,
      "m_Localized": "Збільшує кількість атак / снарядів.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 15698171240448,
      "m_Localized": "Вампіризм",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 15698712305664,
      "m_Localized": "Твій шанс зцілитися на 1 при влучанні у ворога. Більше 100% гарантує зцілення на 1 і шанс на зцілення на 2.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 15967261007872,
      "m_Localized": "Шанс Криту",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 15967873376256,
      "m_Localized": "Шанс здійснити критичні удари. Понад 100% шанс Криту дасть тобі можливість Оверкриту, завдаючи ще більше шкоди.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 16175109742592,
      "m_Localized": "Шкода Від Крита",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 16175835357184,
      "m_Localized": "Підвищує шкоду від твоїх критичних ударів. Критичні удари за замовчуванням завдають удвічі більше шкоди.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 16480819978240,
      "m_Localized": "Шкода Елітам",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 16481419763712,
      "m_Localized": "Збільшує шкоду, яку ти завдаєш елітним ворогам.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 16640631349248,
      "m_Localized": "Відкидання",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 16641403101184,
      "m_Localized": "Відстань, на яку ти відштовхуєш ворогів при влучанні.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 16888908980224,
      "m_Localized": "Швидкість Руху",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 16890188242944,
      "m_Localized": "Як швидко ти переміщаєшся",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17000058036224,
      "m_Localized": "Висота Стрибка",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17001215664128,
      "m_Localized": "Як високо ти можеш стрибнути",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17069079502848,
      "m_Localized": "Зменшення Шкоди Падіння",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17069855449088,
      "m_Localized": "Зменшення шкоди падіння знижує шкоду від падіння. Понад 100% оздоровлює від падіння. Заткнись. Це фіча, а не баг.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17244841811968,
      "m_Localized": "Діапазон Підбору",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17246204960768,
      "m_Localized": "Діапазон підбору збільшує відстань, з якої ти підбираєш досвід.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17377222434816,
      "m_Localized": "Удача",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17378044518400,
      "m_Localized": "Удача підвищує шанс отримати крутіші пропозиції при підвищенні рівня, із храмів та інше.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17565831897088,
      "m_Localized": "Збільшення Золота",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17566733672448,
      "m_Localized": "Збільшення золота дає тобі більше золота з усіх джерел.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17680923598848,
      "m_Localized": "Збільшення досвіду дає тобі більше досвіду з усіх джерел.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17679753388032,
      "m_Localized": "Збільшення Досвіду",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17787811241984,
      "m_Localized": "Складність",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17958506831872,
      "m_Localized": "Складність підвищує кількість, здоров'я, швидкість та силу ворогів. Вибирають тільки геймери.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 18004530929664,
      "m_Localized": "Збільшення Спавну Еліт",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 18009035612160,
      "m_Localized": "Збільшення спавну еліт підвищує шанс на появу елітних ворогів.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 18132130045952,
      "m_Localized": "Збільшення Підсилень",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 18139709153280,
      "m_Localized": "Збільшення підсилень підвищує ефект та тривалість підсилень.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 18365530480640,
      "m_Localized": "Шанс Дропу Підсилень",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 18368768483328,
      "m_Localized": "Шанс дропу підсилень підвищує шанс на дроп підсилень та скринь з ворогів.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 18497495867392,
      "m_Localized": "Рикошет Снарядів",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 18501094580224,
      "m_Localized": "Деякі снаряди рикошетять",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 18526608531456,
      "m_Localized": "Додаткові Стрибки",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 18530010112000,
      "m_Localized": "Додаткові стрибки дають тобі більше стрибків у повітрі.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 23882051067904,
      "m_Localized": "Збільшення срібла",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 23886740299776,
      "m_Localized": "Збільшення срібла дає більше срібла з усіх джерел.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 381305404235776,
      "m_Localized": "Мінімультіплікатор",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 381343001976832,
      "m_Localized": "Вибух скриньок по всій карті!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 17698515575767040,
