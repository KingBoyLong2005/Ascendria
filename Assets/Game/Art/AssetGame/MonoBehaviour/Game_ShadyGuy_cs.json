  "m_Metadata": {
    "m_Items": []
  },
  "m_TableData": [
    {
      "m_Id": 49826996224,
      "m_Localized": "V žádném případě nevracíme peníze ani nedáváme účtenky. Ani svědky.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 202143145984,
      "m_Localized": "Ty máš peníze? Já mám... zboží, co není kradený.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 235265564672,
      "m_Localized": "Mezi náma... moje nabídky nasadí tomu Moai pořádnou konkurenci.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 260825653248,
      "m_Localized": "Čím víc nakoupíš, tím míň musím nosit. Pomoz kámošovi.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 282938023936,
      "m_Localized": "Věř mi. Jsem naprosto nedůvěryhodný.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 314324000768,
      "m_Localized": "Hej, nežeň to říkat Moai, jo?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 341373067264,
      "m_Localized": "Čicháš to? To je vůně super nabídky.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 348960563200,
      "m_Localized": "Nepotřebuju tolik prstů. Vem si jeden.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 370913550336,
      "m_Localized": "Každý předmět je podezřele teplý, jako by ho právě držel pod kabátem.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 432494321664,
      "m_Localized": "Zamrkáš. Když otevřeš oči, je najednou blíž.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 456225693696,
      "m_Localized": "Yvoní jako spálený cukr a trochu ozón.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 487045439488,
      "m_Localized": "Šedivej Chlápek vytáhne balíček karet, zamíchá je a jednu sní. Odmítne vysvětlovat.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 556817686528,
      "m_Localized": "Máš pocit, že kdybys se ho zeptal na daně, okamžitě by se vypařil.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 582478438400,
      "m_Localized": "Nakloní se blíž a zašeptá: \"Máš krásný oči\"",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
  "references": {
    "version": 2,
    "RefIds": []
  }
}