  "m_TableData": [
    {
      "m_Id": 8138576232448,
      "m_Localized": "Gli upgrade alle armi possono ora avere +1 ai parametri",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 8188253569024,
      "m_Localized": "{stat1} ora attiva le stack di {bloodmark}. Inoltre guadagna {value1} di possibilità di applicare {bloodmark}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 9759620202496,
      "m_Localized": "{value1} possibilità di BONKare un nemico, infliggendo {value2} {stat1}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 9920144605184,
      "m_Localized": "Guarire sopra {stat1} ti permette di {stat2} di {value1}. Inoltre conferisce {value2} {stat3}.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 10333291937792,
      "m_Localized": "{value1} possibilità di evocare il fuoco di drago colpendo nemici. I danni da fuoco possono ora bruciare.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 10851166846976,
      "m_Localized": "Infliggi {value1} {stat1} ai nemici in volo. {value2} possibilità di lanciare un nemico in aria.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 11024613900288,
      "m_Localized": "Spara sfere di energia ai nemici.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 11351337598976,
      "m_Localized": "I critici possono diventare Megacritici. Puoi mangiare un sacco di spaghetti con questa forchetta!",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 11546175602688,
      "m_Localized": "{value1} {stat1}, {value2} {stat2}. La guarigione ora infligge danni ai nemici vicini.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 11799800971264,
      "m_Localized": "{value1} possibilità di infliggere danno da ghiaccio colpendo nemici. Il ghiaccio può ora congelare i nemici.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 11985210179584,
      "m_Localized": "{value1} possibilità di {execute} un nemico. Eseguire {execute} aumenta {stat1} di {value2}.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 12363993579520,
      "m_Localized": "{value1} possibilità di evocare fulmini colpendo nemici. I fulmini possono ora stordire i nemici.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 12828001042432,
      "m_Localized": "+1 possibilità di attivare effetti al colpo",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 13069458735104,
      "m_Localized": "Uccidere un nemico evoca {value1} anime che cercano il bersaglio",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 13201382178816,
      "m_Localized": "Se subisci danni sotto {value1} {stat1}, il tempo rallenta e infliggi {value2} danni.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 13549991755776,
      "m_Localized": "Gli attacchi hanno {value1} di esplodere, infliggendo {value2} {stat1} ai nemici circostanti",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351007
          }
        ]
      }
    },
    {
      "m_Id": 13710050590720,
      "m_Localized": "Attira periodicamente tutta l'esperienza intorno a te",
