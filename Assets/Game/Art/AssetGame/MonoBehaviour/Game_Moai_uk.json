  },
  "m_TableData": [
    {
      "m_Id": 8114642944,
      "m_Localized": "Моай відвертається з тихим несхваленням.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 57334800384,
      "m_Localized": "Моай шепоче одне слово: 'Йой.'",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 65270423552,
      "m_Localized": "Моай ніяково кашляє і уникає зорового контакту.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 79816269824,
      "m_Localized": "Моай оцінює тебе... і вважає трохи прийнятним.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 107351875584,
      "m_Localized": "Моай шепоче єдине слово: 'Та таке.'",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 110858313728,
      "m_Localized": "Моай знизує плечима. Справедливе й об'єктивне рішення.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 157616414720,
      "m_Localized": "Моай киває схвально. Рідкісна честь.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 160179134464,
      "m_Localized": "Моай шепоче одне слово: 'Красота.'",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 163081592832,
      "m_Localized": "Моай починає бітбоксити. Ненадовго.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 224461037568,
      "m_Localized": "Моай робить сальто. Ніхто тобі ніколи не повірить.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 227740983296,
      "m_Localized": "Моай шепоче одне слово: 'Бомба'.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 231004151808,
      "m_Localized": "Моай показує великий палець вгору. Ти навіть не знав, що в нього є пальці.",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
  "references": {
    "version": 2,
    "RefIds": []
  }
}