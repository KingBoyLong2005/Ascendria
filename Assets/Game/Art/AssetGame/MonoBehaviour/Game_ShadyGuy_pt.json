  "m_Metadata": {
    "m_Items": []
  },
  "m_TableData": [
    {
      "m_Id": 49826996224,
      "m_Localized": "Nada de reembolsos, recibos ou testemunhas.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 202143145984,
      "m_Localized": "Você tem grana? Eu tenho... produtos não-roubados.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 235265564672,
      "m_Localized": "Entre nós... o Moai não chega nem perto dos meus negócios.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 260825653248,
      "m_Localized": "Quanto mais você compra, menos peso eu carrego. Dá uma força aí.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 282938023936,
      "m_Localized": "Confia em mim. Sou muito pouco confiável.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 314324000768,
      "m_Localized": "Ei, não conta pro Moai sobre isso, tá?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 341373067264,
      "m_Localized": "Sente o cheiro? Parece uma pechincha incrível.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 348960563200,
      "m_Localized": "Não preciso de tantos dedos. Leve um.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 370913550336,
      "m_Localized": "Cada item é suspeitamente quente, como se ele o tivesse guardado debaixo do casaco.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 432494321664,
      "m_Localized": "Você pisca. Quando abre os olhos, ele está de alguma forma mais perto.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 456225693696,
      "m_Localized": "Ele cheira a açúcar queimado e um pouco de ozônio.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 487045439488,
      "m_Localized": "O Cara Suspeito tira um baralho de cartas, embaralha e come uma. Ele se recusa a explicar.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 556817686528,
      "m_Localized": "Você sente que, se perguntasse sobre impostos, ele evaporaria instantaneamente.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 582478438400,
      "m_Localized": "Ele se inclina e sussurra: \"Você tem olhos lindos\"",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
  "references": {
    "version": 2,
