  "m_TableData": [
    {
      "m_Id": 2487837499392,
      "m_Localized": "아테나",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2565239185408,
      "m_Localized": "도적",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2568280055808,
      "m_Localized": "날쌘 검을 든 교활한 친구",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2685133365248,
      "m_Localized": "덤불",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2689608687616,
      "m_Localized": "그냥 평범한 덤불, 볼 거 없어요.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2804318707712,
      "m_Localized": "칼슘",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2807925809152,
      "m_Localized": "죽이지 못하는 기술로 펑펑 날아다니는 언데드 스케이터",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2887793745920,
      "m_Localized": "여우",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2891753168896,
      "m_Localized": "발이 빨라서 엄청난 행운의 사나이",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2985613303808,
      "m_Localized": "토니 맥줌",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2988041805824,
      "m_Localized": "토니는 호버보드를 고른 게 아니야 - 호버보드가 그를 선택했지!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3526166814720,
      "m_Localized": "서 오피",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3527295082496,
      "m_Localized": "느리긴 하지만, 갑옷 덕분에 상당히 튼실해.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3638968426496,
      "m_Localized": "메가채드",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3640088305664,
      "m_Localized": "완벽하고 강력한 턱선을 갖고 있어요.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3711223701504,
      "m_Localized": "몽키",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3712721068032,
      "m_Localized": "선글라스를 어디서 구했는지 모른다. 아무도 묻지 않는다.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 4507256463360,
      "m_Localized": "노엘",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 4508766412800,
      "m_Localized": "메가본크 디스코드에서 이 캐릭터 만들라고 괴롭혔어요.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 5173664260096,
      "m_Localized": "오우거",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 5174742196224,
      "m_Localized": "크고 강하지만 젖은 양말 수준의 논리적 사고력.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6516210638848,
      "m_Localized": "로비넷",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6517481512960,
      "m_Localized": "가난한 사람에게서 훔쳐 부자에게 준다.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2522230792192,
      "m_Localized": "할인받아 테뮤에서 주문한 캡틴 아메리카",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 14406220750848,
      "m_Localized": "버르도",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 14407441293312,
      "m_Localized": "그 선글라스는 그의 안전이 아니라 당신을 위한 거예요.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 19667685711872,
      "m_Localized": "클랭크",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 19688397185024,
      "m_Localized": "그 이름 어떻게 읽는 건지 모르겠어요.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 5442138539163648,
      "m_Localized": "아목",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 5442140577595392,
      "m_Localized": "정체는 아무도 몰라요. 다들 그냥 아목이라고 불렀는데, 본인은 정정 안 하더라고요.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6274306618294272,
      "m_Localized": "우주 사나이는 현재 7개의 행성과 대부분의 NASA 기념품 가게에서 금지된 상태야.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6274304529530880,
      "m_Localized": "우주 사나이",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6882290591465472,
      "m_Localized": "닌자",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6882292743143424,
      "m_Localized": "엄청 빠르고 잘 숨어 다녀. 얘는 2014년 이후로 세금 신고도 안 했어. 완전 날아다녀.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 9503794055479296,
      "m_Localized": "주사위 머리",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 9503795133415424,
      "m_Localized": "이 녀석은 7이 제일 좋대. 누가 안 좋은 소식 좀 전해줄래?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 10162423796465664,
      "m_Localized": "블라드",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 10162425415467008,
      "m_Localized": "완전 악당처럼 보이지만 사실 엄청 좋은 녀석. 슈퍼에서 보면 항상 인사해 줌. 쿨한 친구야.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 12037842271338496,
      "m_Localized": "채드웰 경",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 12037844410433536,
      "m_Localized": "오피 경의 아내 남친. 새로운 갑옷 사줬고 저녁 8시 반 넘어서까지 깨어 있게 해줌. 나이스한 사람!",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
  "references": {
    "version": 2,
    "RefIds": []
  }
}