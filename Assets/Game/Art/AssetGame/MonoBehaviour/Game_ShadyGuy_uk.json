  "m_Name": "Game_ShadyGuy_uk",
  "m_LocaleId": {
    "m_Code": "uk"
  },
  "m_SharedData": {
    "m_FileID": 1,
    "m_PathID": -5249773014627793321
  },
  "m_Metadata": {
    "m_Items": []
  },
  "m_TableData": [
    {
      "m_Id": 49826996224,
      "m_Localized": "Без повернень, без чеків, без свідків.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 202143145984,
      "m_Localized": "Гроші є? У мене є... точно не крадене добро.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 235265564672,
      "m_Localized": "Між нами... мої пропозиції крутіші за Моаї.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 260825653248,
      "m_Localized": "Чим більше купуєш, тим менше мені носити на собі. Виручи мене.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 282938023936,
      "m_Localized": "Повір мені. Я дуже ненадійний.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 314324000768,
      "m_Localized": "Ей, не говори про це Моаї, гаразд?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 341373067264,
      "m_Localized": "Крутий запах чуєш? Це запах неймовірної угоди.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 348960563200,
      "m_Localized": "Мені не потрібно так багато пальців. Візьми один.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 370913550336,
      "m_Localized": "Кожен предмет підозріло теплий, ніби він щойно тримав його під пальто.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 432494321664,
      "m_Localized": "Ти кліпаєш очима. Як тільки розплющив, він вже якимось чином ближче.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 456225693696,
      "m_Localized": "Від нього пахне горілим цукром з ноткою озону.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 487045439488,
      "m_Localized": "Підозрілий Чувак витягає колоду карт, тасує їх, а потім з’їдає одну. Пояснювати він відмовляється.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 556817686528,
      "m_Localized": "Відчуваєш, якщо запитати його про податки, він одразу розтвориться.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 582478438400,
      "m_Localized": "Він нахиляється і шепоче: \"У тебе красиві очі.\"",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
  "references": {
    "version": 2,
    "RefIds": []
  }
}