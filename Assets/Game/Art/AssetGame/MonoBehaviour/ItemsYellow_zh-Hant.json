  "m_TableData": [
    {
      "m_Id": 8138576232448,
      "m_Localized": "武器升級現在可以有額外+1的屬性",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350994
          }
        ]
      }
    },
    {
      "m_Id": 8188253569024,
      "m_Localized": "{stat1} 現在會觸發 {bloodmark} 疊加。還有 {value1} 機率施加 {bloodmark}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350994
          }
        ]
      }
    },
    {
      "m_Id": 9759620202496,
      "m_Localized": "{value1} 機率 BONK 一個敵人，造成 {value2} {stat1}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350994
          }
        ]
      }
    },
    {
      "m_Id": 9920144605184,
      "m_Localized": "治療超過 {stat1} 後可以使你 {stat2} 增加 {value1}。同時增加 {value2} {stat3}。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350994
          }
        ]
      }
    },
    {
      "m_Id": 10333291937792,
      "m_Localized": "擊中敵人時有{value1}機率召喚龍焰。火焰傷害可附加燃燒效果。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350994
          }
        ]
      }
    },
    {
      "m_Id": 10851166846976,
      "m_Localized": "對空中敵人造成 {value1} {stat1}。有 {value2} 的機率將敵人擊飛。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350994
          }
        ]
      }
    },
    {
      "m_Id": 11024613900288,
      "m_Localized": "對敵人發射能量球。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350994
          }
        ]
      }
    },
    {
      "m_Id": 11351337598976,
      "m_Localized": "暴擊有機會變成超級暴擊。你可以用這把叉子吃很多意大利麵！",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350994
          }
        ]
      }
    },
    {
      "m_Id": 11546175602688,
      "m_Localized": "{value1} {stat1}, {value2} {stat2}。治療將對附近的敵人造成傷害。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350994
          }
        ]
      }
    },
    {
      "m_Id": 11799800971264,
      "m_Localized": "打中敵人時有 {value1} 的機率造成冰霜傷害。冰霜可將敵人凍結。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350994
          }
        ]
      }
    },
    {
      "m_Id": 11985210179584,
      "m_Localized": "{value1} 機率 {execute} 一個敵人。執行 {execute} 提升 {stat1} {value2}。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350994
          }
        ]
      }
    },
    {
      "m_Id": 12363993579520,
      "m_Localized": "打中敵人時有 {value1} 的機率召喚雷電。雷電可令敵人暈眩。",
      "m_Metadata": {
        "m_Items": [
          {
