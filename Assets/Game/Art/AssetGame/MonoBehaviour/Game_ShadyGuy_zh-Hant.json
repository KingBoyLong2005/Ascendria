  "m_Name": "Game_ShadyGuy_zh-Hant",
  "m_LocaleId": {
    "m_Code": "zh-Hant"
  },
  "m_SharedData": {
    "m_FileID": 1,
    "m_PathID": -5249773014627793321
  },
  "m_Metadata": {
    "m_Items": []
  },
  "m_TableData": [
    {
      "m_Id": 49826996224,
      "m_Localized": "不退貨、不收據、無證人。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 202143145984,
      "m_Localized": "有錢嗎？我這有...非偷來的好貨。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 235265564672,
      "m_Localized": "別說出去...摩艾的交易不如我這划算。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 260825653248,
      "m_Localized": "買得越多，我越輕鬆。行行好吧。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 282938023936,
      "m_Localized": "相信我。我可是很不值得信賴的哦。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 314324000768,
      "m_Localized": "嘿，別讓摩艾知道這事，成嗎？",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 341373067264,
      "m_Localized": "聞到了嗎？那是絕佳交易的香氣。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 348960563200,
      "m_Localized": "我不需要這麼多手指。拿一根吧。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 370913550336,
      "m_Localized": "每件商品都可疑地溫熱，像是剛在他衣服下藏著。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 432494321664,
      "m_Localized": "你眨了眨眼，再次張開時，他已經更近了。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 456225693696,
      "m_Localized": "他聞起來像燒焦的糖，加上一點點臭氧味。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 487045439488,
      "m_Localized": "神秘哥拿出一副撲克牌，洗牌，然後吃掉一張。他拒絕解釋。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 556817686528,
      "m_Localized": "你覺得一旦問他有關稅務的問題，他立刻就會消失成霧。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 582478438400,
      "m_Localized": "他靠近你耳旁低語道：\"你的眼睛真美。\"",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
  "references": {
    "version": 2,
    "RefIds": []
  }
}