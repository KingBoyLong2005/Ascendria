    {
      "m_Id": 71368941568,
      "m_Localized": "AFK Геймплей",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 146023358464,
      "m_Localized": "Не можна рухатися чи стрибати! Розслабся... і швидше за все здохнеш купу разів.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20705386414866432,
      "m_Localized": "що за чортівня",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20705385504702464,
      "m_Localized": "ой лишенько",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20705383797620736,
      "m_Localized": "ой ні",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20705323160567808,
      "m_Localized": "Натиск",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20705168688545792,
      "m_Localized": "Малюсік",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704273271750656,
      "m_Localized": "Ріжки та палички",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20703257126109184,
      "m_Localized": "Крихкий",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20703260141813760,
      "m_Localized": "Ти вмираєш від будь-якого удару чи дотику з ворогами.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704279680647168,
      "m_Localized": "Без предметів! Тільки твоя зброя і томи!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704440309907456,
      "m_Localized": "Пацифіст",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704443615019008,
      "m_Localized": "Не завдай шкоди ворогам. Будь-яка шкода призведе до судоку.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704556223692800,
      "m_Localized": "Нереально",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704558501199872,
      "m_Localized": "Жодної зброї. Це випробування просто нереальне.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704669104996352,
      "m_Localized": "Товстун Режим",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704851536248832,
      "m_Localized": "Сліпаки",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704905072345088,
      "m_Localized": "Туман такий густий, що ти нічого не бачиш",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704939255922688,
      "m_Localized": "Збочені Контроли",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20705018280804352,
      "m_Localized": "Чи моя клавіатура підключена не в той роз'єм?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20705171003801600,
      "m_Localized": "Ти малючок з великими мріями",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20710595039985664,
      "m_Localized": "Вороги величезні",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20710667559501824,
      "m_Localized": "Купа ворогів!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20910446734344192,
      "m_Localized": "Турбо Режим",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20910448294625280,
      "m_Localized": "Хапай купу предметів, поки вороги не стали занадто сильними!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 21000850305581056,
      "m_Localized": "Гіпер",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 21001806472675328,
      "m_Localized": "Треба бігти швидше",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 21021763679944704,
