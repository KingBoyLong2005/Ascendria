  "m_TableData": [
    {
      "m_Id": 8114642944,
      "m_Localized": "Моаи отводит взгляд с тихим неодобрением.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 57334800384,
      "m_Localized": "Моаи шепчет одно слово: «Ой».",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 65270423552,
      "m_Localized": "Моаи неловко кашляет и избегает зрительного контакта.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 79816269824,
      "m_Localized": "Моаи оценивает тебя... и считает вполне приемлемым.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 107351875584,
      "m_Localized": "Моаи шепчет одно слово: «Ну такое».",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 110858313728,
      "m_Localized": "Моаи пожимает плечами. Честное и справедливое суждение.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 157616414720,
      "m_Localized": "Моаи одобрительно кивает. Редкая честь.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 160179134464,
      "m_Localized": "Моаи шепчет одно слово: «Круто».",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 163081592832,
      "m_Localized": "Начинает бить битбоксом. Недолго.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 224461037568,
      "m_Localized": "Моаи делает сальто. Никто тебе не поверит.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 227740983296,
      "m_Localized": "Моаи шепчет одно слово: «Красота».",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 231004151808,
      "m_Localized": "Моаи показывает палец вверх. Ты даже не знал, что у него есть пальцы.",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
  "references": {
    "version": 2,
    "RefIds": []
  }
}