    },
    {
      "m_Id": 20703260141813760,
      "m_Localized": "데미지나 적의 접촉 시 즉사.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704279680647168,
      "m_Localized": "아이템 금지! 무기랑 주문서에 의존해야 해!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704440309907456,
      "m_Localized": "평화주의자",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704443615019008,
      "m_Localized": "적에게 상처 주지 마세요. 적에게 피해를 주면 수두코로!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704556223692800,
      "m_Localized": "불가능",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704558501199872,
      "m_Localized": "무기 사용 금지. 이건 그냥 절대 불가능임.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 20704669104996352,
      "m_Localized": "초크 모드",
