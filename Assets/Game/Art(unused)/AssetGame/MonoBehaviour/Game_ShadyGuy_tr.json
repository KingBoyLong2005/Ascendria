  "m_Name": "Game_ShadyGuy_tr",
  "m_LocaleId": {
    "m_Code": "tr"
  },
  "m_SharedData": {
    "m_FileID": 1,
    "m_PathID": -5249773014627793321
  },
  "m_Metadata": {
    "m_Items": []
  },
  "m_TableData": [
    {
      "m_Id": 49826996224,
      "m_Localized": "\"İade yok, fiş yok, tanık yok.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 202143145984,
      "m_Localized": "\"Paran var mı? Benim de... çalıntı-olmayan mallarım.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 235265564672,
      "m_Localized": "\"Aramızda kalsın... Moai'nin anlaşmaları benimkilerle yarışamaz.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 260825653248,
      "m_Localized": "\"Ne kadar çok alırsan, taşımam gereken o kadar azalır. Yardım et biraz.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 282938023936,
      "m_Localized": "\"Bana güven. Çok güvenilmezim.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 314324000768,
      "m_Localized": "\"Hey, Moai'ye bundan bahsetme, tamam mı?\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 341373067264,
      "m_Localized": "\"Duyuyor musun? Bu, muhteşem bir fırsatın kokusu.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 348960563200,
      "m_Localized": "\"Bu kadar parmağa ihtiyacım yok. Birini al.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 370913550336,
      "m_Localized": "\"Her öğe şüpheli bir şekilde sıcak, sanki ceketinin altında tuttuğu gibi.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 432494321664,
      "m_Localized": "\"Gözlerini kırpıyorsun. Açtığında, nasıl olduysa sana daha da yakın.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 456225693696,
      "m_Localized": "\"Yanık şeker ve biraz da ozon gibi kokuyor.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 487045439488,
      "m_Localized": "\"Şaibeli Adam kart destesini çıkarıp karıştırıyor ve bir tanesini yiyor. Açıklama yapmaya yanaşmıyor.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 556817686528,
      "m_Localized": "\"Ona vergileri sorsan hemen buharlaşacakmış gibi hissediyorsun.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 582478438400,
      "m_Localized": "\"Yaklaşıp fısıldıyor: 'Güzel gözlerin var.'\"",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
  "references": {
    "version": 2,
    "RefIds": []
  }
}