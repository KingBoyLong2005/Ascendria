  "m_TableData": [
    {
      "m_Id": 2347068686336,
      "m_Localized": "{value1} {stat1} для всіх зброї",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350954
          }
        ]
      }
    },
    {
      "m_Id": 42098337382400,
      "m_Localized": "Завдай {value1} більше шкоди найближчим ворогам.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350954
          }
        ]
      }
    },
    {
      "m_Id": 42292055506944,
      "m_Localized": "Стоячи на місці, ти лікуєшся",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350954
          }
        ]
      }
    },
    {
      "m_Id": 42514454282240,
      "m_Localized": "Посиль {stat1}, коли отримуєш шкоду. Також отримай {value1} {stat1}.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350954
          }
        ]
      }
    },
    {
      "m_Id": 42954235445248,
      "m_Localized": "Збільшуй {stat1} на {value1}, коли відкриваєш скриню.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350954
          }
        ]
      }
    },
    {
      "m_Id": 43471762227200,
      "m_Localized": "Крити мають {value1} шанс вилікувати тебе",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350954
          }
        ]
      }
    },
    {
      "m_Id": 43507740966912,
      "m_Localized": "Збільшує {stat1} на {value1} за вбивство (Макс {value2} стаки)",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350954
          }
        ]
      }
    },
    {
      "m_Id": 43850231054336,
      "m_Localized": "{value1} шанс створити додатковий фрагмент XP при вбивстві ворога",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350954
          }
        ]
      }
    },
    {
      "m_Id": 44018707857408,
      "m_Localized": "При отриманні шкоди, висилай електричний шок найближчим ворогам.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350954
          }
        ]
      }
    },
    {
      "m_Id": 44116615495680,
      "m_Localized": "Скачи вище і далі",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350954
          }
        ]
      }
    },
    {
      "m_Id": 44426897522688,
      "m_Localized": "Більше золота при шкоді",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350954
          }
        ]
      }
    },
    {
      "m_Id": 44585307996160,
      "m_Localized": "Заробляй гроші, рухаючись",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350954
          }
        ]
      }
    },
    {
      "m_Id": 44710906429440,
      "m_Localized": "Чим довше стоїш на місці, тим більше шкоди завдаєш. Макс {value1} шкоди.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350954
          }
        ]
      }
    },
    {
      "m_Id": 44909192151040,
      "m_Localized": "Кевін тебе ненавидить. {value1} шанс, що Кевін тебе вдарить, коли ти вдаряєш ворога. Кевін не може тебе вбити, але дуже хоче.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350954
          }
        ]
      }
    },
    {
      "m_Id": 45762040954880,
