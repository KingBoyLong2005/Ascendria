  "m_Name": "Game_ShadyGuy_it",
  "m_LocaleId": {
    "m_Code": "it"
  },
  "m_SharedData": {
    "m_FileID": 1,
    "m_PathID": -5249773014627793321
  },
  "m_Metadata": {
    "m_Items": []
  },
  "m_TableData": [
    {
      "m_Id": 49826996224,
      "m_Localized": "Niente rimborsi, niente ricevute, niente testimoni.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 202143145984,
      "m_Localized": "Hai soldi? Io ho... merce non proprio rubata.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 235265564672,
      "m_Localized": "Tra noi... i miei affari battono quelli dei Moai.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 260825653248,
      "m_Localized": "Più compri, meno porto dietro. Dai, aiutami!",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 282938023936,
      "m_Localized": "Fidati. Sono molto poco affidabile.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 314324000768,
      "m_Localized": "Ehi, non dire ai Moai di questo, ok?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 341373067264,
      "m_Localized": "Senti questo odore? È l'odore di un affare incredibile.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 348960563200,
      "m_Localized": "Non mi servono tutte queste dita. Prendine una.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 370913550336,
      "m_Localized": "Ogni oggetto è stranamente caldo, come se fosse stato appena tenuto sotto il suo cappotto.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 432494321664,
      "m_Localized": "Sbatti le palpebre. Quando apri gli occhi, è stranamente più vicino.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 456225693696,
      "m_Localized": "Odora di zucchero bruciato e un po' di ozono.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 487045439488,
      "m_Localized": "Il Tizio Sospetto tira fuori un mazzo di carte, le mescola e poi ne mangia una. Si rifiuta di spiegare.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 556817686528,
      "m_Localized": "Senti che se gli chiedessi delle tasse, evaporerebbe all'istante.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 582478438400,
      "m_Localized": "Si avvicina e sussurra: \"Hai degli occhi bellissimi\"",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
  "references": {
    "version": 2,
    "RefIds": []
  }
}