  "m_TableData": [
    {
      "m_Id": 8114642944,
      "m_Localized": "モアイが静かに不満そうに顔を背ける。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 57334800384,
      "m_Localized": "モアイが一言ささやく：「イマイチ」。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 65270423552,
      "m_Localized": "モアイがぎこちなく咳払いをして目を合わせない。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 79816269824,
      "m_Localized": "モアイが君を見て…まぁ合格と言っている。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 107351875584,
      "m_Localized": "モアイが一言ささやく：「まあまあ」。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 110858313728,
      "m_Localized": "モアイが肩をすくめる。フェアで適切な判断。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 157616414720,
      "m_Localized": "モアイが認めるようにうなずく。珍しい栄誉だ。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 160179134464,
      "m_Localized": "モアイが一言ささやく：「ナイス」。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 163081592832,
      "m_Localized": "モアイが短くビートボックスを始める。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 224461037568,
      "m_Localized": "モアイがバックフリップを決める。誰も信じてくれないだろう。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 227740983296,
      "m_Localized": "モアイが一言ささやく：「最高」。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 231004151808,
      "m_Localized": "モアイが親指を立てる。親指があったの知らなかったでしょ？",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
