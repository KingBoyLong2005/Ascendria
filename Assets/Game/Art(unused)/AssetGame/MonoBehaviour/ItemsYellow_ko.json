    {
      "m_Id": 8188253569024,
      "m_Localized": "{stat1}가 이제 {bloodmark} 스택을 발동해! 또한 {value1} 확률로 {bloodmark}을 적용한다.",
      "m_Metadata": {
        "m_Items": [
          {
