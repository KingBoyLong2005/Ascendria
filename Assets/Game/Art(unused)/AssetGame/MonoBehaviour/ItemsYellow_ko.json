          }
        ]
      }
    },
    {
      "m_Id": 10851166846976,
      "m_Localized": "공중의 적에게 {value1} {stat1} 피해. {value2} 확률로 적을 공중으로 띄움",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350992
