  "m_TableData": [
    {
      "m_Id": 8138576232448,
      "m_Localized": "Зброя тепер може отримати +1 до характеристик",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 8188253569024,
      "m_Localized": "{stat1} тепер активує {bloodmark} заряди. Також отримай шанс {value1} нанести {bloodmark}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 9759620202496,
      "m_Localized": "{value1} шанс наносити БОНК ворогу, завдаючи {value2} {stat1}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 9920144605184,
      "m_Localized": "Зцілення понад {stat1} збільшує {stat2} на {value1}. Також додає {value2} {stat3}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 10333291937792,
      "m_Localized": "{value1} шанс викликати Драконовий вогонь при атаці ворога. Вогняна шкода тепер накладає підпал",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 10851166846976,
      "m_Localized": "Завдає {value1} {stat1} повітряним ворогам. {value2} шанс підкинути ворога в повітря.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 11024613900288,
      "m_Localized": "Стріляє енергетичними кулями по ворогах",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 11351337598976,
      "m_Localized": "Критичні удари мають шанс стати Мегакритами. З цим виделкою ти зможеш їсти купу спагеті!",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 11546175602688,
      "m_Localized": "{value1} {stat1}, {value2} {stat2}. Зцілення тепер випромінює шкоду ворогам поблизу.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 11799800971264,
      "m_Localized": "{value1} шанс завдати крижаної шкоди при атаці ворога. Крижана шкода може заморозити ворогів",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 11985210179584,
      "m_Localized": "{value1} шанс {execute} ворога. Успішне {execute} підвищує {stat1} ({value2})",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 12363993579520,
      "m_Localized": "{value1} шанс викликати блискавку при атаці ворога. Блискавка може оглушити ворогів",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 12828001042432,
      "m_Localized": "+1 шанс активувати ефекти при ударі",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 13069458735104,
      "m_Localized": "Убив ворога, призиває {value1} душ, що наводяться",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 13201382178816,
      "m_Localized": "Якщо отримуєш шкоду нижче {value1}{stat1}, час сповільнюється і ти завдаєш {value2} шкоди.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 13549991755776,
      "m_Localized": "Удари мають {value1} шанс вибухнути і завдати {value2} {stat1} найближчим ворогам",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351005
          }
        ]
      }
    },
    {
      "m_Id": 13710050590720,
