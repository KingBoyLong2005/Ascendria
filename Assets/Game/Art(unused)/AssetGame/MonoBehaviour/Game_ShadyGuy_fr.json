  "m_Metadata": {
    "m_Items": []
  },
  "m_TableData": [
    {
      "m_Id": 49826996224,
      "m_Localized": "Pas de remboursements, pas de tickets, pas de témoins.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 202143145984,
      "m_Localized": "T'as des sous ? J'ai des... trucs pas du tout volés.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 235265564672,
      "m_Localized": "Entre nous... mes affaires battent les Moaïs à plates coutures.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 260825653248,
      "m_Localized": "Plus tu achètes, moins je me traîne. Un p'tit coup de main ?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 282938023936,
      "m_Localized": "Confiance aveugle. Je suis pas fiable du tout.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 314324000768,
      "m_Localized": "Hé, dis rien aux Moaïs, d'accord ?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 341373067264,
      "m_Localized": "Tu sens ça ? Ça sent la bonne affaire.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 348960563200,
      "m_Localized": "J'ai pas besoin de tous ces doigts. Prends-en un.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 370913550336,
      "m_Localized": "Tous les objets sont étrangement chauds, comme s'il venait juste de les sortir de sous son manteau.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 432494321664,
      "m_Localized": "Tu clignes des yeux. Quand tu les rouvres, il s'est rapproché.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 456225693696,
      "m_Localized": "Il sent le sucre brûlé et un p'tit peu l'ozone.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 487045439488,
      "m_Localized": "Le Type Louche sort un jeu de cartes, les mélange, et en mange une. Il refuse d’expliquer.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 556817686528,
      "m_Localized": "Tu sens que si tu lui parles d'impôts, il s'évaporera sur-le-champ.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 582478438400,
      "m_Localized": "Il s'approche et murmure : \"T'as de beaux yeux.\"",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
  "references": {
    "version": 2,
    "RefIds": []
  }
}