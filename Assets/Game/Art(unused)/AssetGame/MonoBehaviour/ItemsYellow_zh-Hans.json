  "m_TableData": [
    {
      "m_Id": 8138576232448,
      "m_Localized": "武器升级现在可额外+1属性",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 8188253569024,
      "m_Localized": "{stat1}现在会触发{bloodmark}层。另有{value1}几率施加{bloodmark}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 9759620202496,
      "m_Localized": "{value1}几率BONK敌人，造成{value2}{stat1}伤害",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 9920144605184,
      "m_Localized": "治疗超过 {stat1} 可以让你 {stat2} 增加 {value1}。还提供 {value2} {stat3}。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 10333291937792,
      "m_Localized": "{value1} 几率召唤龙焰攻击敌人。火焰伤害现可附加灼烧。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 10851166846976,
      "m_Localized": "对空中敌人造成 {value1} {stat1} 伤害。{value2} 几率把敌人打上天。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 11024613900288,
      "m_Localized": "射出能量球攻击敌人。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 11351337598976,
      "m_Localized": "暴击有几率变成超级暴击。用这个叉子可以吃好多意大利面！",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 11546175602688,
      "m_Localized": "{value1} {stat1}, {value2} {stat2}。治疗现在会对附近敌人造成伤害。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 11799800971264,
      "m_Localized": "{value1} 几率在攻击时造成冰霜伤害。冰霜可以冻结敌人。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 11985210179584,
      "m_Localized": "{value1} 几率 {execute} 一个敌人。执行 {execute} 提高 {stat1} {value2}。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 12363993579520,
      "m_Localized": "{value1} 几率在攻击时召唤闪电。闪电可以眩晕敌人。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 12828001042432,
      "m_Localized": "+1 几率触发击中效果",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 13069458735104,
      "m_Localized": "击杀敌人时召唤 {value1} 个追踪魂灵",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 13201382178816,
      "m_Localized": "当生命值低于{value1}{stat1}时，减慢时间并造成{value2}伤害。",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039350996
          }
        ]
      }
    },
    {
      "m_Id": 13549991755776,
      "m_Localized": "攻击有 {value1} 几率爆炸，对周围敌人造成 {value2} {stat1} 伤害",
