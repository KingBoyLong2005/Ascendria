  "m_TableData": [
    {
      "m_Id": 2487837499392,
      "m_Localized": "Афіна",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2565239185408,
      "m_Localized": "Бандит",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2568280055808,
      "m_Localized": "Хитрий хлопець з гострим мечем",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2685133365248,
      "m_Localized": "Кущ",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2689608687616,
      "m_Localized": "Просто звичайний кущ, тут нічого немає.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2804318707712,
      "m_Localized": "Кальцій",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2807925809152,
      "m_Localized": "Нежить, що виконує найкрутіші трюки.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2891753168896,
      "m_Localized": "Швидкий на ноги і незвичайно везучий.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2887793745920,
      "m_Localized": "Лис",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2985613303808,
      "m_Localized": "Тоні МакЗум",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2988041805824,
      "m_Localized": "Тоні не обирав ховерборд — ховерборд вибрав його.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3526166814720,
      "m_Localized": "Сер Уфі",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3527295082496,
      "m_Localized": "Він повільний, але його броня робить його досить міцним.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3640088305664,
      "m_Localized": "Володіє ідеальною, найпотужнішою щелепою.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3638968426496,
      "m_Localized": "Мегачад",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3711223701504,
      "m_Localized": "Мавпа",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3712721068032,
      "m_Localized": "Ніхто не знає, де він взяв ці окуляри. І ніхто не питає.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 4507256463360,
      "m_Localized": "Ноель",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 4508766412800,
      "m_Localized": "Мене змусив чат Megabonk у Discord створити цього персонажа.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 5173664260096,
      "m_Localized": "Огр",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 5174742196224,
      "m_Localized": "Великий і сильний, з критичним мисленням мокрого носка.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6517481512960,
      "m_Localized": "Краде у бідних, дає багатим.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2522230792192,
      "m_Localized": "Капітан Америка, але замовлений з Temu (зі знижкою)",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6516210638848,
      "m_Localized": "Робінетт",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 14406220750848,
      "m_Localized": "Бірдо",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 14407441293312,
      "m_Localized": "Окуляри для твоєї безпеки, не його.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 19667685711872,
      "m_Localized": "КЛ4НК",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 19688397185024,
      "m_Localized": "Я не знаю, як вимовити його ім’я.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 5442138539163648,
      "m_Localized": "Амог",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 5442140577595392,
      "m_Localized": "Ніхто не знає його справжнього імені. Всі просто почали називати його Амогом, і він так і не виправив їх.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6274306618294272,
      "m_Localized": "Космонавт отримав бан на 7 планетах і в більшості магазинів NASA.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6274304529530880,
      "m_Localized": "Космонавт",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6882290591465472,
      "m_Localized": "Ніндзя",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6882292743143424,
      "m_Localized": "Дуже швидкий та невловимий. Не платив податки з 2014 року. Проблеми в самого ніндзя.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 9503794055479296,
      "m_Localized": "Кубоголовий",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 9503795133415424,
      "m_Localized": "Його улюблене число — 7. Хтось скаже йому, що це погана ідея?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 10162423796465664,
      "m_Localized": "Влад",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 10162425415467008,
      "m_Localized": "Виглядає як злий босс, але насправді він просто суперський чувак. Завжди привітається в магазині. Справжній свій.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 12037842271338496,
      "m_Localized": "Сер Чедвелл",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 12037844410433536,
      "m_Localized": "Бойфренд дружини сера Уфі. Купив йому нову броню і дозволяє сидіти за компом після 20:30. Крутий чувак!",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
