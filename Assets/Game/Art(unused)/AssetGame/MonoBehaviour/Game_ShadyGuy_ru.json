  "m_Name": "Game_ShadyGuy_ru",
  "m_LocaleId": {
    "m_Code": "ru"
  },
  "m_SharedData": {
    "m_FileID": 1,
    "m_PathID": -5249773014627793321
  },
  "m_Metadata": {
    "m_Items": []
  },
  "m_TableData": [
    {
      "m_Id": 49826996224,
      "m_Localized": "Без возвратов, без чеков, без свидетелей.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 202143145984,
      "m_Localized": "Есть деньги? У меня есть... ни разу не краденые товары.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 235265564672,
      "m_Localized": "Между нами... у Моаи нет таких сделок, как у меня.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 260825653248,
      "m_Localized": "Чем больше купишь, тем меньше мне таскать. Выручай, а?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 282938023936,
      "m_Localized": "Поверь мне. Я абсолютно ненадежный тип.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 314324000768,
      "m_Localized": "Эй, только не говори Моаи об этом, ладно?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 341373067264,
      "m_Localized": "Пахнет? Это запах нереально крутого предложения.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 348960563200,
      "m_Localized": "Мне столько пальцев не надо. Забери один.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 370913550336,
      "m_Localized": "Кажется, все товары подозрительно теплые, будто он держал их под плащом.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 432494321664,
      "m_Localized": "Ты моргнул. Открываешь глаза — он уже ближе.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 456225693696,
      "m_Localized": "Пахнет жженым сахаром и немного озоном.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 487045439488,
      "m_Localized": "Темный тип достает колоду, тасует и съедает карту. Объяснять отказывается.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 556817686528,
      "m_Localized": "Так и кажется, спроси ты его о налогах, он испарится.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 582478438400,
      "m_Localized": "Он наклоняется поближе и шепчет: \"У вас красивые глаза\".",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
  "references": {
    "version": 2,
    "RefIds": []
  }
}