  "m_TableData": [
    {
      "m_Id": 8138576232448,
      "m_Localized": "Ulepszenia broni mogą teraz mieć +1 do statystyk",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351003
          }
        ]
      }
    },
    {
      "m_Id": 8188253569024,
      "m_Localized": "{stat1} teraz aktywuje {bloodmark} stosy. Dodatkowo masz {value1} szansy na nałożenie {bloodmark}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351003
          }
        ]
      }
    },
    {
      "m_Id": 9759620202496,
      "m_Localized": "{value1} szansa na BONKnięcie przeciwnika, zadając {value2} {stat1}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351003
          }
        ]
      }
    },
    {
      "m_Id": 9920144605184,
      "m_Localized": "Leczenie powyżej {stat1} pozwala ci {stat2} o {value1}. Daje również {value2} {stat3}.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351003
          }
        ]
      }
    },
    {
      "m_Id": 10333291937792,
      "m_Localized": "{value1} szansa na przywołanie smoczego ognia, gdy atakujesz. Ogień teraz może podpalać.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351003
          }
        ]
      }
    },
    {
      "m_Id": 10851166846976,
      "m_Localized": "Zadaj {value1} {stat1} wrogom w powietrzu. {value2} szansa na wyrzucenie wroga w powietrze.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351003
          }
        ]
      }
    },
    {
      "m_Id": 11024613900288,
      "m_Localized": "Strzelaj kulami energii do wrogów.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351003
          }
        ]
      }
    },
    {
      "m_Id": 11351337598976,
      "m_Localized": "Kryty mogą stać się Megakrytami. Możesz zjeść dużo spaghetti tą widelcem!",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351003
          }
        ]
      }
    },
    {
      "m_Id": 11546175602688,
      "m_Localized": "{value1} {stat1}, {value2} {stat2}. Leczenie teraz promieniuje obrażeniami na pobliskich wrogów.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351003
          }
        ]
      }
    },
    {
      "m_Id": 11799800971264,
      "m_Localized": "{value1} szansa na zadanie obrażeń lodowych, gdy atakujesz. Lód teraz może zamrażać wrogów.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351003
          }
        ]
      }
    },
    {
      "m_Id": 11985210179584,
      "m_Localized": "{value1} szansa na {execute} przeciwnika. Wykonanie {execute} zwiększa {stat1} o {value2}.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351003
          }
        ]
      }
    },
    {
      "m_Id": 12363993579520,
      "m_Localized": "{value1} szansa na przywołanie błyskawicy, gdy atakujesz. Błyskawica teraz może ogłuszać.",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351003
          }
        ]
      }
    },
    {
      "m_Id": 12828001042432,
      "m_Localized": "+1 szansa na wywołanie efektów przy trafieniu",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351003
          }
        ]
      }
    },
    {
      "m_Id": 13069458735104,
      "m_Localized": "Zabicie wroga przywołuje {value1} homingowe dusze",
