  "m_Name": "Game_ShadyGuy_en",
  "m_LocaleId": {
    "m_Code": "en"
  },
  "m_SharedData": {
    "m_FileID": 1,
    "m_PathID": -5249773014627793321
  },
  "m_Metadata": {
    "m_Items": []
  },
  "m_TableData": [
    {
      "m_Id": 49826996224,
      "m_Localized": "\"No refunds, no receipts, no witnesses.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 202143145984,
      "m_Localized": "\"You got money? I got... not-stolen goods.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 235265564672,
      "m_Localized": "\"Between you and me... the Moai's got nothing on my deals.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 260825653248,
      "m_Localized": "\"The more you buy, the less I have to carry. Help a guy out.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 282938023936,
      "m_Localized": "\"Trust me. I'm very untrustworthy.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 314324000768,
      "m_Localized": "\"Hey, don't tell the Moai about this, okay?\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 341373067264,
      "m_Localized": "\"You smell that? It's the smell of an amazing deal.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 348960563200,
      "m_Localized": "\"I don't need this many fingers. Take one.\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 370913550336,
      "m_Localized": "Every item is suspiciously warm, as if he was just holding it under his coat.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 432494321664,
      "m_Localized": "You blink. When you open your eyes, he's somehow closer.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 456225693696,
      "m_Localized": "He smells like burnt sugar and a little bit of ozone.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 487045439488,
      "m_Localized": "The Shady Guy pulls out a deck of cards, shuffles them, and then eats one. He refuses to elaborate.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 556817686528,
      "m_Localized": "You feel like if you asked him about taxes, he would immediately evaporate.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 582478438400,
      "m_Localized": "He leans in close and whispers: \"You have beautiful eyes\"",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
  "references": {
    "version": 2,
    "RefIds": []
  }
}