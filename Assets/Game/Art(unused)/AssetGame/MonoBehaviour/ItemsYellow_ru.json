    {
      "m_Id": 8138576232448,
      "m_Localized": "Теперь улучшения оружия могут иметь +1 к характеристикам",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351000
          }
        ]
      }
    },
    {
      "m_Id": 8188253569024,
      "m_Localized": "{stat1} теперь вызывает {bloodmark} стаки. Также получи {value1} шанс нанести {bloodmark}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351000
          }
        ]
      }
    },
    {
      "m_Id": 9759620202496,
      "m_Localized": "{value1} шанс БОНКнуть врага, нанеся {value2} {stat1}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351000
          }
        ]
      }
    },
    {
      "m_Id": 9920144605184,
      "m_Localized": "Лечение выше {stat1} увеличивает {stat2} на {value1}. Также даёт {value2} {stat3}",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351000
          }
        ]
      }
    },
    {
      "m_Id": 10333291937792,
      "m_Localized": "{value1} шанс призвать драконье пламя при атаке врага. Огненный урон накладывает горение",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351000
          }
        ]
      }
    },
    {
      "m_Id": 10851166846976,
      "m_Localized": "Наносит {value1} {stat1} воздушным врагам. {value2} шанс подбросить врагов вверх",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351000
          }
        ]
      }
    },
    {
      "m_Id": 11024613900288,
      "m_Localized": "Стреляет энергетическими сферами по врагам",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351000
          }
        ]
      }
    },
    {
      "m_Id": 11351337598976,
      "m_Localized": "Криты имеют шанс стать Мегакритами. Этой вилкой можно слопать кучу спагетти!",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351000
          }
        ]
      }
    },
    {
      "m_Id": 11546175602688,
      "m_Localized": "{value1} {stat1},  {value2} {stat2}. Лечение теперь наносит урон ближайшим врагам",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351000
          }
        ]
      }
    },
    {
      "m_Id": 11799800971264,
      "m_Localized": "{value1} шанс нанести ледяной урон при атаке врага. Ледяной урон может заморозить врагов",
      "m_Metadata": {
        "m_Items": [
          {
            "rid": 4160208315039351000
