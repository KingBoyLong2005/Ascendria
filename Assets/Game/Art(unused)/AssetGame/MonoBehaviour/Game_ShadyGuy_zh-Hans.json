  "m_Name": "Game_ShadyGuy_zh-Hans",
  "m_LocaleId": {
    "m_Code": "zh-Hans"
  },
  "m_SharedData": {
    "m_FileID": 1,
    "m_PathID": -5249773014627793321
  },
  "m_Metadata": {
    "m_Items": []
  },
  "m_TableData": [
    {
      "m_Id": 49826996224,
      "m_Localized": "\"不退货、不收据、没人作证。\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 202143145984,
      "m_Localized": "\"有钱吗？我这儿有点……不是偷来的货。\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 235265564672,
      "m_Localized": "\"悄悄告诉你……摩艾那点货不算啥。\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 260825653248,
      "m_Localized": "\"你买得越多，我就背得越少。帮帮忙吧。\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 282938023936,
      "m_Localized": "\"相信我，我可是非常不靠谱的。\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 314324000768,
      "m_Localized": "\"嘿，别跟摩艾说这事，成吧？\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 341373067264,
      "m_Localized": "\"闻到了吗？是个绝妙的交易味儿。\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 348960563200,
      "m_Localized": "\"我手指太多了，拿一个走吧。\"",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 370913550336,
      "m_Localized": "你眨了眨眼，再睁开时他离你更近了。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 432494321664,
      "m_Localized": "你眨了眨眼，再睁开时他就到了你跟前。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 456225693696,
      "m_Localized": "他闻起来像烤焦的糖还有一点点臭氧的味道。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 487045439488,
      "m_Localized": "神秘家伙拿出一副牌，洗牌后直接吃了一张，拒绝解释原因。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 556817686528,
      "m_Localized": "你感觉只要一问他税务的事，他马上就会消失得无影无踪。",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 582478438400,
      "m_Localized": "他靠近你，低声说：\"你的眼睛真美。\"",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
  "references": {
    "version": 2,
    "RefIds": []
  }
}