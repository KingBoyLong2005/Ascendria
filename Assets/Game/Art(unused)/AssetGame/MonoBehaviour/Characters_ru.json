  "m_TableData": [
    {
      "m_Id": 2487837499392,
      "m_Localized": "Афина",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2565239185408,
      "m_Localized": "Бандит",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2568280055808,
      "m_Localized": "Проворный парень с острым мечом",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2685133365248,
      "m_Localized": "Куст",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2689608687616,
      "m_Localized": "Просто обычный куст, ничего особенного.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2804318707712,
      "m_Localized": "Кальций",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2807925809152,
      "m_Localized": "Нежить-шреддер, выполняющий самые крутые трюки.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2891753168896,
      "m_Localized": "Быстро бегает и чертовски везучий.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2887793745920,
      "m_Localized": "Лис",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2985613303808,
      "m_Localized": "Тони МакЗум",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2988041805824,
      "m_Localized": "Тони не выбирал ховерборд — это ховерборд выбрал его.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3526166814720,
      "m_Localized": "Сэр Уфи",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3527295082496,
      "m_Localized": "Он медлительный, но его доспехи делают его настоящим танком.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3640088305664,
      "m_Localized": "У него идеальная и мощная челюсть.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3638968426496,
      "m_Localized": "Мегачад",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3711223701504,
      "m_Localized": "Обезьян",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 3712721068032,
      "m_Localized": "Никто не знает, откуда у него эти очки. Никто и не спрашивает.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 4507256463360,
      "m_Localized": "Ноэль",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 4508766412800,
      "m_Localized": "На Дискорде Мегабонка меня вынудили создать этого персонажа",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 5173664260096,
      "m_Localized": "Огр",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 5174742196224,
      "m_Localized": "Большой и сильный, с аналитическими способностями мокрого носка.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6517481512960,
      "m_Localized": "Крадет у бедных, отдает богатым.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 2522230792192,
      "m_Localized": "Капитан Америка, заказанный с Temu (со скидкой)",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6516210638848,
      "m_Localized": "Робинетта",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 14406220750848,
      "m_Localized": "Бирдо",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 14407441293312,
      "m_Localized": "Эти очки — для твоей безопасности, не его.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 19667685711872,
      "m_Localized": "КЛ4НК",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 19688397185024,
      "m_Localized": "Я не знаю, как произносится его имя.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 5442138539163648,
      "m_Localized": "Амог",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 5442140577595392,
      "m_Localized": "Никто не знает его настоящее имя. Все просто начали звать его Амог, и он так и не стал их поправлять.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6274306618294272,
      "m_Localized": "Космонавт временно забанен на 7 планетах и во всех сувенирных лавках НАСА.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6274304529530880,
      "m_Localized": "Космонавт",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6882290591465472,
      "m_Localized": "Ниндзя",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 6882292743143424,
      "m_Localized": "Очень быстрый и ловкий. С налогами не заморачивался с 2014 года. Он готов.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 9503794055479296,
      "m_Localized": "Кубоголовый",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 9503795133415424,
      "m_Localized": "Его любимое число — 7. Кто расскажет ему плохие новости?",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 10162423796465664,
      "m_Localized": "Влад",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 10162425415467008,
      "m_Localized": "Выглядит злым, но на самом деле отличный парень. Всегда здоровается в магазине. Классный тип.",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 12037842271338496,
      "m_Localized": "Сэр Чадвэлл",
      "m_Metadata": {
        "m_Items": []
      }
    },
    {
      "m_Id": 12037844410433536,
      "m_Localized": "Парень жены сэра Оуфи. Купил ему новые доспехи и разрешает засиживаться допоздна. Классный чувак!",
      "m_Metadata": {
        "m_Items": []
      }
    }
  ],
